# Nunca publique o arquivo .env no GitHub.
PORT=3000
# Endereço do site autorizado a usar a API (ex.: https://usuario.github.io)
FRONTEND_ORIGIN=*
# Frase longa e aleatória usada para assinar os logins. Troque em produção.
AUTH_SECRET=troque-por-uma-frase-longa-e-aleatoria
# Banco Postgres (Neon, Supabase, Render...). Sem ele, os dados ficam em data/db.json.
DATABASE_URL=
# Máximo de votos por pessoa (IP) por hora, somando todas as pesquisas.
VOTE_LIMIT_PER_HOUR=30
